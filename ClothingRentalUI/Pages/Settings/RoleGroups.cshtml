@page
@model ClothingRentalUI.Pages.Settings.RoleGroupsModel
@{
    ViewData["Title"] = "Quản lý Nhóm Quyền";
}

<style>
    /* Card Layout */
    .role-groups-card, .groups-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
        padding: 30px;
        margin-bottom: 30px;
    }

    .card-header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .card-title-group h2 {
        font-size: 1.5rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 4px;
    }

    .card-title-group p {
        font-size: 0.88rem;
        color: #64748b;
    }

    /* Sub Navigation Tabs */
    .settings-nav-tabs {
        display: flex;
        gap: 8px;
        border-bottom: 1px solid #e2e8f0;
        margin-bottom: 24px;
    }

    .nav-tab-item {
        padding: 12px 20px;
        font-weight: 600;
        font-size: 0.92rem;
        color: #64748b;
        text-decoration: none;
        border-bottom: 2px solid transparent;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }

    .nav-tab-item:hover {
        color: #2563eb;
    }

    .nav-tab-item.active {
        color: #2563eb;
        border-bottom-color: #2563eb;
    }

    .table-responsive {
        overflow-x: auto;
        overflow-y: auto;
        max-height: 500px;
        border-radius: 12px;
        border: 1px solid #f1f5f9;
    }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 0.95rem;
    }

    .custom-table th {
        background-color: #f8fafc;
        color: #475569;
        font-weight: 600;
        padding: 16px 20px;
        border-bottom: 1px solid #f1f5f9;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .custom-table td {
        padding: 16px 20px;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
        vertical-align: middle;
    }

    .custom-table tbody tr {
        transition: background-color 0.2s ease;
    }

    .custom-table tbody tr:hover {
        background-color: #f8fafc;
    }

    .group-name-cell {
        font-weight: 700;
        color: #0f172a;
    }

    /* Badges */
    .badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.2px;
    }

    .badge-perm-count {
        background: #eff6ff;
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
    }

    /* Buttons */
    .btn-primary-grad {
        background: linear-gradient(90deg, #2563eb 0%, #3b82f6 100%);
        color: #ffffff;
        border: none;
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
        transition: all 0.25s ease;
        text-decoration: none;
    }

    .btn-primary-grad:hover {
        background: linear-gradient(90deg, #1d4ed8 0%, #2563eb 100%);
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(37, 99, 235, 0.3);
    }

    .action-btn-group {
        display: flex;
        gap: 8px;
    }

    .btn-action-outline {
        border-radius: 8px;
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        font-size: 1rem;
    }

    .btn-action-outline:hover {
        background: #f8fafc;
        border-color: #94a3b8;
    }

    .btn-action-outline.edit {
        color: #2563eb;
    }

    .btn-action-outline.edit:hover {
        border-color: #2563eb;
        background: rgba(37, 99, 235, 0.05);
    }

    .btn-action-outline.delete {
        color: #ef4444;
    }

    .btn-action-outline.delete:hover {
        border-color: #ef4444;
        background: rgba(239, 68, 68, 0.05);
    }

    .badge-count {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
        padding: 4px 10px;
        border-radius: 9999px;
        font-size: 0.78rem;
        font-weight: 700;
    }

    /* Modern Groups Filter & Search Toolbar */
    .groups-filter-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
        flex-wrap: wrap;
        background: #f8fafc;
        padding: 16px 20px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }

    .search-input-wrapper {
        position: relative;
        flex: 1;
        min-width: 280px;
        display: flex;
        align-items: center;
    }

    .search-input-wrapper .search-icon {
        position: absolute;
        left: 14px;
        color: #94a3b8;
        font-size: 0.95rem;
        pointer-events: none;
    }

    .search-input-field {
        width: 100%;
        padding: 10px 38px 10px 38px;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        font-size: 0.92rem;
        color: #0f172a;
        outline: none;
        transition: all 0.2s ease;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }

    .search-input-field:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    .btn-clear-search {
        position: absolute;
        right: 12px;
        color: #94a3b8;
        text-decoration: none;
        font-size: 0.85rem;
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f1f5f9;
        transition: all 0.2s;
    }

    .btn-clear-search:hover {
        background: #e2e8f0;
        color: #0f172a;
    }

    .btn-filter-submit {
        background: #2563eb;
        color: #ffffff;
        border: none;
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
        box-shadow: 0 2px 4px rgba(37, 99, 235, 0.2);
    }

    .btn-filter-submit:hover {
        background: #1d4ed8;
    }

    .btn-filter-reset {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        color: #64748b;
        padding: 10px 16px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
    }

    .btn-filter-reset:hover {
        background: #f1f5f9;
        color: #0f172a;
        border-color: #94a3b8;
    }

    /* Modal System */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.25s ease;
        padding: 20px;
        box-sizing: border-box;
    }

    .modal-overlay.active {
        display: flex;
        opacity: 1;
    }

    .modal-container {
        background: #ffffff;
        border-radius: 16px;
        width: 100%;
        max-width: 540px;
        max-height: calc(100vh - 40px);
        display: flex;
        flex-direction: column;
        border: 1px solid #e2e8f0;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        overflow: hidden;
        transform: translateY(20px) scale(0.95);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        margin: auto;
    }

    .modal-container.modal-lg {
        max-width: 700px;
    }

    .modal-container.modal-xl {
        max-width: 980px;
    }

    .modal-overlay.active .modal-container {
        transform: translateY(0) scale(1);
    }

    .modal-header {
        padding: 18px 24px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #f8fafc;
        flex-shrink: 0;
    }

    .modal-header h3 {
        font-size: 1.15rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    .btn-close-modal {
        background: transparent;
        border: none;
        font-size: 1.5rem;
        color: #94a3b8;
        cursor: pointer;
        line-height: 1;
        transition: color 0.2s;
    }

    .btn-close-modal:hover {
        color: #475569;
    }

    .modal-body {
        padding: 20px 24px;
        overflow-y: auto !important;
        max-height: calc(90vh - 140px);
        flex: 1 1 auto;
        min-height: 0;
    }

    /* Custom Sleek Scrollbar */
    .modal-body::-webkit-scrollbar {
        width: 8px;
    }
    .modal-body::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 6px;
    }
    .modal-body::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 6px;
    }
    .modal-body::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    .modal-footer {
        padding: 16px 24px;
        border-top: 1px solid #e2e8f0;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        background: #f8fafc;
        flex-shrink: 0;
    }

    /* Forms */
    .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: #334155;
        margin-bottom: 6px;
    }

    .form-input, .form-select, .form-textarea {
        width: 100%;
        padding: 10px 14px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        background-color: #ffffff;
        font-size: 0.95rem;
        color: #0f172a;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

    .form-input:focus, .form-select:focus, .form-textarea:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
    }

    .form-textarea {
        resize: vertical;
        min-height: 70px;
    }

    .btn-cancel {
        padding: 10px 18px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #475569;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-cancel:hover {
        background: #f1f5f9;
        color: #1e293b;
    }

    .btn-submit-action {
        padding: 10px 18px;
        border-radius: 8px;
        border: none;
        background: #2563eb;
        color: #ffffff;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-submit-action:hover {
        background: #1d4ed8;
    }

    /* Alerts */
    .alert-box {
        border-radius: 12px;
        padding: 14px 20px;
        margin-bottom: 24px;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .alert-box-success {
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: #065f46;
    }

    .alert-box-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
    }

    .perm-tools-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
        flex-wrap: wrap;
        gap: 8px;
    }

    .btn-perm-tool {
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
        padding: 5px 12px;
        font-size: 0.8rem;
        font-weight: 600;
        border-radius: 6px;
        cursor: pointer;
        color: #334155;
        transition: all 0.2s;
    }

    .btn-perm-tool:hover {
        background: #e2e8f0;
        color: #0f172a;
    }

    /* Sidebar-like Permission Tree Hierarchy Styles */
    .perm-sidebar-tree {
        padding: 10px 14px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .perm-tree-parent {
        border: 1px solid #f1f5f9;
        border-radius: 10px;
        background: #ffffff;
        overflow: hidden;
        transition: all 0.2s ease;
    }

    .perm-tree-parent:hover {
        border-color: #cbd5e1;
    }

    .perm-tree-parent.expanded {
        border-color: #bfdbfe;
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.05);
    }

    .perm-parent-header {
        display: flex;
        align-items: center;
        padding: 12px 16px;
        background: #fafafa;
        cursor: pointer;
        user-select: none;
        gap: 12px;
        transition: background 0.15s ease;
    }

    .perm-parent-header:hover {
        background: #f1f5f9;
    }

    .perm-tree-parent.expanded .perm-parent-header {
        background: #f8fafc;
        border-bottom: 1px solid #f1f5f9;
    }

    .perm-checkbox-custom {
        width: 18px;
        height: 18px;
        accent-color: #2563eb;
        cursor: pointer;
        flex-shrink: 0;
    }

    .perm-parent-icon {
        font-size: 1.25rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        flex-shrink: 0;
    }

    .perm-parent-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #0f172a;
        flex: 1;
        font-family: 'Outfit', sans-serif;
    }

    .perm-parent-count {
        font-size: 0.78rem;
        color: #64748b;
        font-weight: 600;
        background: #e2e8f0;
        padding: 2px 8px;
        border-radius: 9999px;
        margin-right: 6px;
    }

    .perm-parent-arrow {
        color: #64748b;
        font-size: 0.85rem;
        transition: transform 0.2s ease;
    }

    .perm-tree-parent.expanded .perm-parent-arrow {
        transform: rotate(90deg);
    }

    /* Submenu Tree container */
    .perm-submenu-tree {
        margin-left: 28px;
        padding: 10px 14px 12px 18px;
        border-left: 2px dashed #cbd5e1;
        display: flex;
        flex-direction: column;
        gap: 8px;
        background: #ffffff;
    }

    .perm-tree-parent:not(.expanded) .perm-submenu-tree {
        display: none;
    }

    .perm-submenu-item {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 8px 12px;
        border-radius: 8px;
        transition: all 0.15s ease;
    }

    .perm-submenu-item:hover {
        background: #f8fafc;
    }

    .perm-submenu-item.has-checked {
        background: #eff6ff;
    }

    .perm-submenu-header {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .perm-submenu-icon {
        font-size: 1.1rem;
        width: 24px;
        text-align: center;
        flex-shrink: 0;
    }

    .perm-submenu-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: #334155;
        flex: 1;
    }

    .perm-submenu-item.has-checked .perm-submenu-title {
        color: #2563eb;
        font-weight: 700;
    }

    .perm-code-tag {
        font-family: monospace;
        font-size: 0.7rem;
        color: #1d4ed8;
        background: #ffffff;
        border: 1px solid #bfdbfe;
        padding: 1px 6px;
        border-radius: 4px;
        font-weight: 600;
    }

    /* Sub-action permissions list */
    .perm-actions-row {
        margin-left: 34px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding-top: 2px;
    }

    .perm-action-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 0.78rem;
        color: #475569;
        cursor: pointer;
        transition: all 0.15s ease;
        user-select: none;
    }

    .perm-action-chip:hover {
        border-color: #2563eb;
        color: #2563eb;
    }

    .perm-action-chip:has(input:checked) {
        background: #dbeafe;
        border-color: #3b82f6;
        color: #1d4ed8;
        font-weight: 600;
    }

    .badge-code-mini {
        font-family: monospace;
        font-size: 0.65rem;
        color: #64748b;
        background: #f1f5f9;
        padding: 1px 4px;
        border-radius: 3px;
    }
</style>

<div class="settings-nav-tabs">
    <a href="/Settings/Users" class="nav-tab-item">
        <span>👥</span> Người dùng & Tài khoản
    </a>
    <a href="/Settings/RoleGroups" class="nav-tab-item active">
        <span>🛡️</span> Nhóm quyền mẫu (Role Groups)
    </a>
    <a href="/Settings/MenuManager" class="nav-tab-item">
        <span>📑</span> Quản lý Menu & Quyền
    </a>
    <a href="/Settings/SystemSettings" class="nav-tab-item">
        <span>⚙️</span> Cấu hình hệ thống
    </a>
</div>

<!-- Main Workspace Card -->
<div class="role-groups-card">
    
    <!-- Success & Error Alert Messages -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert-box alert-box-success">
            <span>✅</span> @Model.SuccessMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert-box alert-box-error">
            <span>❌</span> @Model.ErrorMessage
        </div>
    }

    <div class="card-header-flex">
        <div class="card-title-group">
            <h2>Danh sách Nhóm Quyền Mẫu</h2>
            <p>Tạo các bộ quyền chuẩn (Thu ngân, Thủ kho, Kế toán...) để phân quyền nhanh chóng cho nhân viên mới chỉ với 1 click.</p>
        </div>
        <button type="button" class="btn-primary-grad" onclick="openCreateGroupModal()">
            <span>+</span> Thêm nhóm quyền mới
        </button>
    </div>

    <!-- Modern Filters & Search Toolbar -->
    <form method="get" class="groups-filter-bar">
        <div class="search-input-wrapper">
            <i class="fas fa-search search-icon"></i>
            <input type="text" 
                   id="groupSearchInput" 
                   name="SearchTerm" 
                   value="@Model.SearchTerm" 
                   class="search-input-field" 
                   placeholder="Tìm kiếm theo Tên nhóm quyền, Mô tả chức năng..." 
                   oninput="filterGroupList()"
                   autocomplete="off" />
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a href="/Settings/RoleGroups" class="btn-clear-search" title="Xóa tìm kiếm">✕</a>
            }
        </div>

        <button type="submit" class="btn-filter-submit">
            <i class="fas fa-search"></i> Tìm kiếm
        </button>

        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <a href="/Settings/RoleGroups" class="btn-filter-reset" title="Đặt lại">
                <i class="fas fa-undo"></i> Đặt lại
            </a>
        }
    </form>

    <!-- Table -->
    <div class="table-responsive">
        <table class="custom-table" id="groupsTable">
            <thead>
                <tr>
                    <th style="width: 250px;">Tên nhóm quyền</th>
                    <th>Mô tả chức năng & phạm vi</th>
                    <th style="width: 140px; text-align: center;">Số quyền</th>
                    <th style="width: 140px; text-align: center;">Ngày tạo</th>
                    <th style="width: 120px; text-align: right;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.RoleGroupsList.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align: center; color: #64748b; padding: 40px;">
                            Chưa có nhóm quyền nào được thiết lập. Hãy bấm nút <strong>"Thêm nhóm quyền mới"</strong> ở trên để tạo.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var group in Model.RoleGroupsList)
                    {
                        var permIdsJson = string.Join(",", group.RoleGroupPermissions.Select(p => p.PermissionId));
                        <tr class="group-row">
                            <td style="font-weight: 700; color: #0f172a;" class="group-name-cell">
                                <span style="font-size: 1.1rem; margin-right: 6px;">🛡️</span> @group.Name
                            </td>
                            <td style="color: #64748b; font-size: 0.88rem;" class="group-desc-cell">
                                @(string.IsNullOrWhiteSpace(group.Description) ? "Không có mô tả" : group.Description)
                            </td>
                            <td style="text-align: center;">
                                <span class="badge-count">@group.RoleGroupPermissions.Count quyền</span>
                            </td>
                            <td style="text-align: center; color: #64748b; font-size: 0.85rem;">
                                @group.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td style="text-align: right;">
                                <div class="action-btn-group">
                                    <button type="button" class="btn-action-outline edit" title="Chỉnh sửa nhóm quyền"
                                            onclick="openEditGroupModal(@group.Id, '@Html.Raw(Html.Encode(group.Name))', '@Html.Raw(Html.Encode(group.Description ?? ""))', [@permIdsJson])">
                                        ✏️
                                    </button>
                                    <form method="post" asp-page-handler="DeleteRoleGroup" onsubmit="return confirm('Bạn có chắc chắn muốn xóa nhóm quyền: @Html.Raw(Html.Encode(group.Name))?\n(Lưu ý: Quyền đã gán độc lập cho các tài khoản sẽ không bị ảnh hưởng).');" style="display:inline;">
                                        <input type="hidden" name="roleGroupId" value="@group.Id" />
                                        <button type="submit" class="btn-action-outline delete" title="Xóa nhóm quyền">
                                            🗑️
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal 1: Thêm Nhóm Quyền Mới (Sidebar Tree Look & Feel) -->
<div class="modal-overlay" id="createGroupModalOverlay">
    <div class="modal-container modal-xl">
        <form method="post" asp-page-handler="CreateRoleGroup">
            <div class="modal-header">
                <h3>Thêm nhóm quyền mẫu mới</h3>
                <button type="button" class="btn-close-modal" onclick="closeModal('createGroupModalOverlay')">×</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label" for="createGroupName">Tên nhóm quyền <span style="color: #ef4444;">*</span></label>
                    <input type="text" id="createGroupName" name="name" class="form-input" placeholder="Ví dụ: Nhân viên Bán hàng & Thu ngân" required />
                </div>
                <div class="form-group">
                    <label class="form-label" for="createGroupDesc">Mô tả vai trò / chức năng</label>
                    <textarea id="createGroupDesc" name="description" class="form-textarea" placeholder="Mô tả phạm vi quyền hạn của nhóm này..."></textarea>
                </div>

                <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 18px 0;" />

                <div class="perm-tools-bar">
                    <span class="form-label" style="margin-bottom: 0;">Danh sách chức năng & quyền hạn gán cho nhóm:</span>
                    <div>
                        <button type="button" class="btn-perm-tool" onclick="toggleAllPerms('createPermsSidebarTree', true)">Chọn tất cả</button>
                        <button type="button" class="btn-perm-tool" onclick="toggleAllPerms('createPermsSidebarTree', false)">Bỏ chọn tất cả</button>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 12px;">
                    <input type="text" class="form-input" placeholder="🔍 Tìm kiếm nhanh quyền (tên menu, tên quyền, mã code)..." oninput="filterModalPerms(this, 'createPermsSidebarTree')" autocomplete="off" />
                </div>

                <div class="perm-sidebar-tree" id="createPermsSidebarTree">
                    @foreach (var parent in ClothingRentalUI.Data.PermissionGrouper.BuildSidebarTree(Model.AllPermissions))
                    {
                        <div class="perm-tree-parent" data-group="@parent.Key">
                            <div class="perm-parent-header" onclick="toggleTreeAccordion(this, event)">
                                <input type="checkbox" class="perm-checkbox-custom parent-checkbox" title="Chọn/bỏ chọn toàn bộ nhánh này" onclick="toggleParentBranch(this, event)" />
                                <span class="perm-parent-icon">@parent.Icon</span>
                                <span class="perm-parent-title">@parent.Name</span>
                                <span class="perm-parent-count">@parent.Children.Count mục</span>
                                <i class="fas fa-chevron-right perm-parent-arrow"></i>
                            </div>
                            
                            <div class="perm-submenu-tree">
                                @foreach (var child in parent.Children)
                                {
                                    <div class="perm-submenu-item" data-perm-key="@child.Key">
                                        <div class="perm-submenu-header">
                                            @if (child.MainPermission != null)
                                            {
                                                <input type="checkbox" name="selectedPermissions" value="@child.MainPermission.Id" id="create-perm-@child.MainPermission.Id" class="perm-checkbox-custom perm-child-checkbox" onchange="onChildPermChange(this)" />
                                                <label for="create-perm-@child.MainPermission.Id" class="perm-submenu-label" style="display: flex; align-items: center; gap: 8px; flex: 1; cursor: pointer; margin: 0;">
                                                    <span class="perm-submenu-icon">@child.Icon</span>
                                                    <span class="perm-submenu-title">@child.Name</span>
                                                    <span class="perm-code-tag">@child.MainPermission.Code</span>
                                                </label>
                                            }
                                            else
                                            {
                                                <span class="perm-submenu-icon">@child.Icon</span>
                                                <span class="perm-submenu-title">@child.Name</span>
                                            }
                                        </div>

                                        @if (child.ActionPermissions.Any())
                                        {
                                            <div class="perm-actions-row">
                                                @foreach (var act in child.ActionPermissions)
                                                {
                                                    <label class="perm-action-chip" for="create-perm-@act.Id">
                                                        <input type="checkbox" name="selectedPermissions" value="@act.Id" id="create-perm-@act.Id" class="perm-checkbox-custom" style="width: 14px; height: 14px;" onchange="onChildPermChange(this)" />
                                                        <span>@act.Name</span>
                                                        <span class="badge-code-mini">@act.Code</span>
                                                    </label>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" onclick="closeModal('createGroupModalOverlay')">Hủy bỏ</button>
                <button type="submit" class="btn-submit-action">Tạo nhóm quyền</button>
            </div>
        </form>
    </div>
</div>

