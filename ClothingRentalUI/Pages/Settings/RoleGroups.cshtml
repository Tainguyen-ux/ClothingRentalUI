<script>
    function openModal(id) {
        const modal = document.getElementById(id);
        if (modal) modal.classList.add('active');
    }

    function closeModal(id) {
        const modal = document.getElementById(id);
        if (modal) modal.classList.remove('active');
    }

    function openCreateGroupModal() {
        document.getElementById('createGroupName').value = '';
        document.getElementById('createGroupDesc').value = '';
        toggleAllPerms('createPermsSidebarTree', false);

        // Collapse all branches by default
        document.querySelectorAll('#createPermsSidebarTree .perm-tree-parent').forEach(p => {
            p.classList.remove('expanded');
        });

        openModal('createGroupModalOverlay');
    }

    function openEditGroupModal(id, name, desc, permIds) {
        document.getElementById('editGroupId').value = id;
        document.getElementById('editGroupName').value = name;
        document.getElementById('editGroupDesc').value = desc || '';

        // Reset all checkboxes in edit modal
        const container = document.getElementById('editPermsSidebarTree');
        if (container) {
            const checkboxes = container.querySelectorAll('input[name="selectedPermissions"]');
            checkboxes.forEach(cb => {
                const permId = parseInt(cb.value, 10);
                cb.checked = permIds.includes(permId);
            });
            syncAllTreeStates('#editPermsSidebarTree');
        }

        // Collapse all branches by default
        document.querySelectorAll('#editPermsSidebarTree .perm-tree-parent').forEach(p => {
            p.classList.remove('expanded');
        });

        openModal('editGroupModalOverlay');
    }

    function toggleTreeAccordion(headerEl, event) {
        if (event.target.tagName === 'INPUT' || event.target.classList.contains('parent-checkbox')) {
            return;
        }
        const parentNode = headerEl.closest('.perm-tree-parent');
        if (parentNode) {
            parentNode.classList.toggle('expanded');
        }
    }

    function toggleParentBranch(parentCb, event) {
        event.stopPropagation();
        const parentNode = parentCb.closest('.perm-tree-parent');
        if (!parentNode) return;
        const isChecked = parentCb.checked;
        const childCbs = parentNode.querySelectorAll('.perm-submenu-tree input[name="selectedPermissions"]');
        childCbs.forEach(cb => {
            cb.checked = isChecked;
        });
        syncParentTreeState(parentNode);
    }

    function onChildPermChange(cb) {
        const parentNode = cb.closest('.perm-tree-parent');
        if (parentNode) {
            syncParentTreeState(parentNode);
        }
    }

    function syncParentTreeState(parentNode) {
        const childCbs = parentNode.querySelectorAll('.perm-submenu-tree input[name="selectedPermissions"]');
        const total = childCbs.length;
        let checkedCount = 0;
        childCbs.forEach(cb => {
            if (cb.checked) checkedCount++;
        });

        const parentCb = parentNode.querySelector('.parent-checkbox');
        if (parentCb) {
            parentCb.checked = (total > 0 && checkedCount === total);
            parentCb.indeterminate = (checkedCount > 0 && checkedCount < total);
        }

        // Submenu item highlight
        parentNode.querySelectorAll('.perm-submenu-item').forEach(subItem => {
            const subCbs = subItem.querySelectorAll('input[name="selectedPermissions"]');
            let hasAny = false;
            subCbs.forEach(c => { if (c.checked) hasAny = true; });
            if (hasAny) {
                subItem.classList.add('has-checked');
            } else {
                subItem.classList.remove('has-checked');
            }
        });
    }

    function syncAllTreeStates(treeSelector) {
        const tree = document.querySelector(treeSelector);
        if (!tree) return;
        tree.querySelectorAll('.perm-tree-parent').forEach(p => {
            syncParentTreeState(p);
        });
    }

    function toggleAllPerms(containerId, isChecked) {
        const container = document.getElementById(containerId);
        if (!container) return;
        const checkboxes = container.querySelectorAll('input[name="selectedPermissions"]');
        checkboxes.forEach(cb => {
            cb.checked = isChecked;
        });
        syncAllTreeStates('#' + containerId);
    }

    function filterModalPerms(inputElem, containerId) {
        const query = inputElem.value.toLowerCase().trim();
        const container = document.getElementById(containerId);
        if (!container) return;
        const parents = container.querySelectorAll('.perm-tree-parent');

        parents.forEach(parent => {
            const parentTitle = parent.querySelector('.perm-parent-title').textContent.toLowerCase();
            const childItems = parent.querySelectorAll('.perm-submenu-item');
            let visibleChildren = 0;

            childItems.forEach(child => {
                const text = child.textContent.toLowerCase();
                if (!query || text.includes(query) || parentTitle.includes(query)) {
                    child.style.display = 'flex';
                    visibleChildren++;
                } else {
                    child.style.display = 'none';
                }
            });

            if (visibleChildren > 0) {
                parent.style.display = 'block';
                if (query) {
                    parent.classList.add('expanded');
                }
            } else {
                parent.style.display = 'none';
            }
        });
    }

    function filterGroupList() {
        const query = document.getElementById('groupSearchInput').value.toLowerCase().trim();
        const rows = document.querySelectorAll('#groupsTable .group-row');
        rows.forEach(row => {
            const name = row.querySelector('.group-name-cell').textContent.toLowerCase();
            const desc = row.querySelector('.group-desc-cell').textContent.toLowerCase();
            row.style.display = (!query || name.includes(query) || desc.includes(query)) ? '' : 'none';
        });
    }

    window.onclick = function(event) {
        if (event.target.classList.contains('modal-overlay')) {
            event.target.classList.remove('active');
        }
    }
</script>
