            </div>
        </form>
    </div>
</div>

<!-- 3. Modal Phân quyền chi tiết (Sidebar Tree Look & Feel) -->
<div class="modal-overlay" id="permissionModalOverlay">
    <div class="modal-container modal-xl">
        <form method="post" asp-page-handler="UpdatePermissions">
            <input type="hidden" id="permUserId" name="userId" />
            <input type="hidden" id="permRoleGroupId" name="roleGroupId" />
            <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
            <input type="hidden" name="RoleFilter" value="@Model.RoleFilter" />
            <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
            <input type="hidden" name="PageIndex" value="@Model.PageIndex" />
            <div class="modal-header">
                <h3>Phân quyền tài khoản: <span id="permUsernameHeader" style="color: #2563eb;"></span></h3>
                <button type="button" class="btn-close-modal" onclick="closeModal('permissionModalOverlay')">×</button>
            </div>
            <div class="modal-body">
                <!-- Thanh công cụ Áp dụng nhanh Nhóm quyền mẫu -->
                <div style="display: flex; gap: 10px; align-items: center; background: #f8fafc; padding: 12px 16px; border-radius: 10px; border: 1px solid #e2e8f0; margin-bottom: 16px; flex-wrap: wrap;">
                    <span style="font-size: 0.88rem; font-weight: 600; color: #334155; white-space: nowrap;">🛡️ Nhóm quyền của tài khoản:</span>
                    <select id="quickRoleGroupSelect" class="form-select" style="padding: 6px 12px; font-size: 0.88rem; flex: 1; min-width: 200px;" onchange="onQuickRoleGroupDropdownChange(this)">
                        <option value="">-- Tùy chỉnh riêng (Không gắn nhóm) --</option>
                        @foreach (var rg in Model.AllRoleGroups)
                        {
                            var rgPermsJson = string.Join(",", rg.RoleGroupPermissions.Select(p => p.PermissionId));
                            <option value="@rg.Id" data-perms="[@rgPermsJson]">🛡️ @rg.Name (@rg.RoleGroupPermissions.Count quyền)</option>
                        }
                    </select>
                    <button type="button" class="btn-primary-grad" style="padding: 6px 14px; font-size: 0.85rem;" onclick="applyQuickRoleGroup()">
                        Áp dụng quyền theo nhóm
                    </button>
                </div>

                <div class="form-group" style="margin-bottom: 16px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; flex-wrap: wrap; gap: 8px;">
                        <label class="form-label" for="permSearchInput" style="margin-bottom: 0;">Tìm kiếm nhanh chức năng & quyền hạn</label>
                        <div style="display: flex; gap: 6px;">
                            <button type="button" class="btn-action-outline" style="width: auto; height: auto; padding: 4px 10px; font-size: 0.78rem; font-weight: 600;" onclick="toggleAllUserPerms(true)">Chọn tất cả</button>
                            <button type="button" class="btn-action-outline" style="width: auto; height: auto; padding: 4px 10px; font-size: 0.78rem; font-weight: 600;" onclick="toggleAllUserPerms(false)">Bỏ chọn tất cả</button>
                        </div>
                    </div>
                    <input type="text" id="permSearchInput" class="form-input" placeholder="🔍 Nhập từ khóa tìm kiếm (tên menu, tên quyền, mã code)..." oninput="filterPermissions()" autocomplete="off" />
                </div>
                
                <!-- Sidebar Tree Permission Container -->
                <div class="perm-sidebar-tree" id="userPermsSidebarTree">
                    <div id="noPermsMessage" style="display: none; text-align: center; color: #64748b; padding: 24px; font-size: 0.95rem; background: #f8fafc; border-radius: 12px; border: 1px dashed #cbd5e1;">
                        🔍 Không tìm thấy quyền hạn nào phù hợp với từ khóa tìm kiếm.
                    </div>

                    @foreach (var parent in ClothingRentalUI.Data.PermissionGrouper.BuildSidebarTree(Model.AllPermissions))
                    {
                        <div class="perm-tree-parent" data-group="@parent.Key">
                            <div class="perm-parent-header" onclick="toggleTreeAccordion(this, event)">
                                <input type="checkbox" class="perm-checkbox-custom parent-checkbox" title="Chọn/bỏ chọn toàn bộ nhánh này" onclick="toggleParentBranch(this, event)" />
                                <span class="perm-parent-icon">@parent.Icon</span>
                                <span class="perm-parent-title">@parent.Name</span>
                                <span class="perm-parent-count">@parent.Children.Count mục</span>
                                <i class="fas fa-chevron-right perm-parent-arrow"></i>
                            </div>
                            
                            <div class="perm-submenu-tree">
                                @foreach (var child in parent.Children)
                                {
                                    <div class="perm-submenu-item" data-perm-key="@child.Key">
                                        <div class="perm-submenu-header">
                                            @if (child.MainPermission != null)
                                            {
                                                <input type="checkbox" name="selectedPermissions" value="@child.MainPermission.Id" id="perm-@child.MainPermission.Id" class="perm-checkbox-custom perm-child-checkbox" onchange="onChildPermChange(this)" />
                                                <label for="perm-@child.MainPermission.Id" class="perm-submenu-label" style="display: flex; align-items: center; gap: 8px; flex: 1; cursor: pointer; margin: 0;">
                                                    <span class="perm-submenu-icon">@child.Icon</span>
                                                    <span class="perm-submenu-title">@child.Name</span>
                                                    <span class="perm-code-tag">@child.MainPermission.Code</span>
                                                </label>
                                            }
                                            else
                                            {
                                                <span class="perm-submenu-icon">@child.Icon</span>
                                                <span class="perm-submenu-title">@child.Name</span>
                                            }
                                        </div>

                                        @if (child.ActionPermissions.Any())
                                        {
                                            <div class="perm-actions-row">
                                                @foreach (var act in child.ActionPermissions)
                                                {
                                                    <label class="perm-action-chip" for="perm-@act.Id">
                                                        <input type="checkbox" name="selectedPermissions" value="@act.Id" id="perm-@act.Id" class="perm-checkbox-custom" style="width: 14px; height: 14px;" onchange="onChildPermChange(this)" />
                                                        <span>@act.Name</span>
                                                        <span class="badge-code-mini">@act.Code</span>
                                                    </label>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" onclick="closeModal('permissionModalOverlay')">Hủy bỏ</button>
                <button type="submit" class="btn-submit-action">Cập nhật quyền</button>
            </div>
        </form>
    </div>
</div>

<script>
    // Mở và đóng modal
    function openModal(id) {
        const modal = document.getElementById(id);
        if (modal) modal.classList.add('active');
    }

    function closeModal(id) {
        const modal = document.getElementById(id);
        if (modal) modal.classList.remove('active');
    }

    // Modal Create User
    function openCreateModal() {
        document.getElementById('createFullName').value = '';
        document.getElementById('createUsername').value = '';
        document.getElementById('createPassword').value = '';
        document.getElementById('createRole').value = 'Staff';
        document.getElementById('createRoleGroup').value = '';
        document.getElementById('createEmail').value = '';
        document.getElementById('createPhoneNumber').value = '';
        document.getElementById('createTelegramId').value = '';
        openModal('createModalOverlay');
    }

    // Modal Edit User
    function openEditModal(id, username, fullName, role, email, phoneNumber, telegramId, roleGroupId) {
        document.getElementById('editUserId').value = id;
        document.getElementById('editUsername').value = username;
        document.getElementById('editFullName').value = fullName;
        document.getElementById('editRole').value = role;
        document.getElementById('editPassword').value = '';
        document.getElementById('editEmail').value = email || '';
        document.getElementById('editPhoneNumber').value = phoneNumber || '';
        document.getElementById('editTelegramId').value = telegramId || '';
        const rgSelect = document.getElementById('editRoleGroup');
        if (rgSelect) {
            rgSelect.value = (roleGroupId && roleGroupId > 0) ? roleGroupId : '';
        }
        openModal('editModalOverlay');
    }

    // Modal Permission Manager
    function openPermissionModal(userId, username, permissionIds, roleGroupId) {
        document.getElementById('permUserId').value = userId;
        document.getElementById('permUsernameHeader').textContent = username;
        
        // Cập nhật nhóm quyền của tài khoản vào dropdown & hidden input
        const permRgInput = document.getElementById('permRoleGroupId');
        if (permRgInput) {
            permRgInput.value = (roleGroupId && roleGroupId > 0) ? roleGroupId : '';
        }
        const quickSelect = document.getElementById('quickRoleGroupSelect');
        if (quickSelect) {
            quickSelect.value = (roleGroupId && roleGroupId > 0) ? roleGroupId : '';
        }

        // Reset search input and show all items
        const searchInput = document.getElementById('permSearchInput');
        if (searchInput) {
            searchInput.value = '';
        }
        filterPermissions();

        // Reset all checkboxes
        const checkboxes = document.querySelectorAll('#permissionModalOverlay input[name="selectedPermissions"]');
        checkboxes.forEach(cb => {
            cb.checked = false;
        });

        // Check assigned checkboxes
        permissionIds.forEach(id => {
            const cbs = document.querySelectorAll('#permissionModalOverlay input[name="selectedPermissions"][value="' + id + '"]');
            cbs.forEach(cb => { cb.checked = true; });
        });

        // Collapse all branches by default
        document.querySelectorAll('#userPermsSidebarTree .perm-tree-parent').forEach(p => {
            p.classList.remove('expanded');
        });

        // Update visual states
        syncAllTreeStates('#userPermsSidebarTree');

        openModal('permissionModalOverlay');
    }

    function onQuickRoleGroupDropdownChange(selectEl) {
        const permRgInput = document.getElementById('permRoleGroupId');
        if (permRgInput) {
            permRgInput.value = selectEl.value;
        }
    }

    function applyQuickRoleGroup() {
        const select = document.getElementById('quickRoleGroupSelect');
        const selectedOption = select.options[select.selectedIndex];
        const permRgInput = document.getElementById('permRoleGroupId');
        if (permRgInput) {
            permRgInput.value = select.value;
        }

        if (!selectedOption || !selectedOption.value) {
            alert('Vui lòng chọn một nhóm quyền mẫu để áp dụng.');
            return;
        }
        let permsData = [];
        try {
            permsData = JSON.parse(selectedOption.getAttribute('data-perms') || '[]');
        } catch (e) {
            console.error('Error parsing role group permissions:', e);
            permsData = [];
        }

        const checkboxes = document.querySelectorAll('#permissionModalOverlay input[name="selectedPermissions"]');
        checkboxes.forEach(cb => {
            const permId = parseInt(cb.value, 10);
            cb.checked = permsData.includes(permId);
        });

        syncAllTreeStates('#userPermsSidebarTree');
    }

    function toggleTreeAccordion(headerEl, event) {
        if (event.target.tagName === 'INPUT' || event.target.classList.contains('parent-checkbox')) {
            return;
        }
        const parentNode = headerEl.closest('.perm-tree-parent');
        if (parentNode) {
            parentNode.classList.toggle('expanded');
        }
    }

    function toggleParentBranch(parentCb, event) {
        event.stopPropagation();
        const parentNode = parentCb.closest('.perm-tree-parent');
        if (!parentNode) return;
        const isChecked = parentCb.checked;
        const childCbs = parentNode.querySelectorAll('.perm-submenu-tree input[name="selectedPermissions"]');
        childCbs.forEach(cb => {
            cb.checked = isChecked;
            const val = cb.value;
            // Đồng bộ mọi checkbox khác có cùng giá trị nếu có
            document.querySelectorAll('#permissionModalOverlay input[name="selectedPermissions"][value="' + val + '"]').forEach(c => {
                c.checked = isChecked;
            });
        });
        syncAllTreeStates('#userPermsSidebarTree');
    }

    function onChildPermChange(cb) {
        const val = cb.value;
        const isChecked = cb.checked;
        // Đồng bộ mọi checkbox khác có cùng mã quyền nếu xuất hiện ở nhiều menu
        document.querySelectorAll('#permissionModalOverlay input[name="selectedPermissions"][value="' + val + '"]').forEach(c => {
            c.checked = isChecked;
        });

        syncAllTreeStates('#userPermsSidebarTree');
    }

    function syncParentTreeState(parentNode) {
        const childCbs = parentNode.querySelectorAll('.perm-submenu-tree input[name="selectedPermissions"]');
        const total = childCbs.length;
        let checkedCount = 0;
        childCbs.forEach(cb => {
            if (cb.checked) checkedCount++;
        });

        const parentCb = parentNode.querySelector('.parent-checkbox');
        if (parentCb) {
            parentCb.checked = (total > 0 && checkedCount === total);
            parentCb.indeterminate = (checkedCount > 0 && checkedCount < total);
        }

        // Submenu item highlight
        parentNode.querySelectorAll('.perm-submenu-item').forEach(subItem => {
            const subCbs = subItem.querySelectorAll('input[name="selectedPermissions"]');
            let hasAny = false;
            subCbs.forEach(c => { if (c.checked) hasAny = true; });
            if (hasAny) {
                subItem.classList.add('has-checked');
            } else {
                subItem.classList.remove('has-checked');
            }
        });
    }

    function syncAllTreeStates(treeSelector) {
        const tree = document.querySelector(treeSelector);
        if (!tree) return;
        tree.querySelectorAll('.perm-tree-parent').forEach(p => {
            syncParentTreeState(p);
        });
    }

    function toggleAllUserPerms(isChecked) {
        const tree = document.getElementById('userPermsSidebarTree');
        if (!tree) return;
        const checkboxes = tree.querySelectorAll('input[name="selectedPermissions"]');
        checkboxes.forEach(cb => {
            cb.checked = isChecked;
        });
        syncAllTreeStates('#userPermsSidebarTree');
    }

    function filterPermissions() {
        const query = document.getElementById('permSearchInput').value.toLowerCase().trim();
        const tree = document.getElementById('userPermsSidebarTree');
        if (!tree) return;
        const parents = tree.querySelectorAll('.perm-tree-parent');
        let totalVisible = 0;

        parents.forEach(parent => {
            const parentTitle = parent.querySelector('.perm-parent-title').textContent.toLowerCase();
            const childItems = parent.querySelectorAll('.perm-submenu-item');
            let visibleChildren = 0;

            childItems.forEach(child => {
                const text = child.textContent.toLowerCase();
                if (!query || text.includes(query) || parentTitle.includes(query)) {
                    child.style.display = 'flex';
                    visibleChildren++;
                } else {
                    child.style.display = 'none';
                }
            });

            if (visibleChildren > 0) {
                parent.style.display = 'block';
                totalVisible += visibleChildren;
                if (query) {
                    parent.classList.add('expanded');
                }
            } else {
                parent.style.display = 'none';
            }
        });

        const noPermsMsg = document.getElementById('noPermsMessage');
        if (noPermsMsg) {
            noPermsMsg.style.display = (totalVisible === 0 && query.length > 0) ? 'block' : 'none';
        }
    }

    // Client-side realtime table row filter
    function filterUsersLive() {
        const input = document.getElementById('userSearchInput');
        if (!input) return;
        const query = input.value.toLowerCase().trim();
        const rows = document.querySelectorAll('#usersTable tbody tr.user-row');
        let matchCount = 0;

        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            if (!query || text.includes(query)) {
                row.style.display = '';
                matchCount++;
            } else {
                row.style.display = 'none';
            }
        });
    }

    // Confirm locking account
    function confirmLock(username, locking) {
        const action = locking ? "khóa" : "mở khóa";
        return confirm(`Bạn có chắc chắn muốn ${action} tài khoản "${username}" không?`);
    }

    // Close modal when clicking outside content area
    window.onclick = function(event) {
        if (event.target.classList.contains('modal-overlay')) {
            event.target.classList.remove('active');
        }
    }
</script>
