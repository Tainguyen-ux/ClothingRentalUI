@page
@model ClothingRentalUI.Pages.Settings.UsersModel
@{
    ViewData["Title"] = "Quản lý người dùng";
}

<style>
    /* Card Layout */
    .users-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
        padding: 30px;
        margin-bottom: 30px;
    }

    .card-header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .card-title-group h2 {
        font-size: 1.5rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 4px;
    }

    .card-title-group p {
        font-size: 0.88rem;
        color: #64748b;
    }

    .table-responsive {
        overflow-x: auto;
        overflow-y: auto;
        max-height: 500px;
        border-radius: 12px;
        border: 1px solid #f1f5f9;
    }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 0.95rem;
    }

    .custom-table th {
        background-color: #f8fafc;
        color: #475569;
        font-weight: 600;
        padding: 16px 20px;
        border-bottom: 1px solid #f1f5f9;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .custom-table td {
        padding: 16px 20px;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
        vertical-align: middle;
    }

    .custom-table tbody tr {
        transition: background-color 0.2s ease;
    }

    .custom-table tbody tr:hover {
        background-color: #f8fafc;
    }

    .user-fullname-cell {
        font-weight: 600;
        color: #0f172a;
    }

    /* Pagination */
    .pagination-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
        padding: 10px 0;
    }
    
    .pagination-info {
        font-size: 0.9rem;
        color: #64748b;
    }

    .pagination-controls {
        display: flex;
        gap: 8px;
    }

    .btn-page {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 16px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #334155;
        font-weight: 600;
        font-size: 0.85rem;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-page:hover:not(.disabled) {
        background: #f8fafc;
        border-color: #94a3b8;
    }

    .btn-page.disabled {
        opacity: 0.5;
        cursor: not-allowed;
        background: #f1f5f9;
    }

    .btn-page.active {
        background: #eff6ff;
        color: #1d4ed8;
        border-color: #bfdbfe;
    }

    /* Badges */
    .badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.2px;
    }

    .badge-role-admin {
        background: #eff6ff;
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
    }

    .badge-role-staff {
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

    .badge-status-active {
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }

    .badge-status-locked {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    /* Buttons */
    .btn-primary-grad {
        background: linear-gradient(90deg, #2563eb 0%, #3b82f6 100%);
        color: #ffffff;
        border: none;
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
        transition: all 0.25s ease;
        text-decoration: none;
    }

    .btn-primary-grad:hover {
        background: linear-gradient(90deg, #1d4ed8 0%, #2563eb 100%);
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(37, 99, 235, 0.3);
    }

    .action-btn-group {
        display: flex;
        gap: 8px;
    }

    .btn-action-outline {
        border-radius: 8px;
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        font-size: 1rem;
    }

    .btn-action-outline:hover {
        background: #f8fafc;
        border-color: #94a3b8;
    }

    .btn-action-outline.edit {
        color: #2563eb;
    }

    .btn-action-outline.edit:hover {
        border-color: #2563eb;
        background: rgba(37, 99, 235, 0.05);
    }

    .btn-action-outline.perm {
        color: #4f46e5;
    }

    .btn-action-outline.perm:hover {
        border-color: #4f46e5;
        background: rgba(79, 70, 229, 0.05);
    }

    .btn-action-outline.lock {
        color: #ea580c;
    }

    .btn-action-outline.lock:hover {
        border-color: #ea580c;
        background: rgba(234, 88, 12, 0.05);
    }

    .btn-action-outline.unlock {
        color: #10b981;
    }

    .btn-action-outline.unlock:hover {
        border-color: #10b981;
        background: rgba(16, 185, 129, 0.05);
    }

    /* Modern Users Filter & Search Toolbar */
    .users-filter-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
        flex-wrap: wrap;
        background: #f8fafc;
        padding: 16px 20px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }

    .search-input-wrapper {
        position: relative;
        flex: 1;
        min-width: 280px;
        display: flex;
        align-items: center;
    }

    .search-input-wrapper .search-icon {
        position: absolute;
        left: 14px;
        color: #94a3b8;
        font-size: 0.95rem;
        pointer-events: none;
    }

    .search-input-field {
        width: 100%;
        padding: 10px 38px 10px 38px;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        font-size: 0.92rem;
        color: #0f172a;
        outline: none;
        transition: all 0.2s ease;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }

    .search-input-field:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    .btn-clear-search {
        position: absolute;
        right: 12px;
        color: #94a3b8;
        text-decoration: none;
        font-size: 0.85rem;
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f1f5f9;
        transition: all 0.2s;
    }

    .btn-clear-search:hover {
        background: #e2e8f0;
        color: #0f172a;
    }

    .filter-select-wrapper {
        min-width: 180px;
    }

    .filter-select {
        width: 100%;
        padding: 10px 14px;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        font-size: 0.9rem;
        color: #334155;
        outline: none;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }

    .filter-select:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    .btn-filter-submit {
        background: #2563eb;
        color: #ffffff;
        border: none;
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
        box-shadow: 0 2px 4px rgba(37, 99, 235, 0.2);
    }

    .btn-filter-submit:hover {
        background: #1d4ed8;
    }

    .btn-filter-reset {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        color: #64748b;
        padding: 10px 16px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
    }

    .btn-filter-reset:hover {
        background: #f1f5f9;
        color: #0f172a;
        border-color: #94a3b8;
    }

    /* Modal Styling */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.25s ease;
        padding: 20px;
        box-sizing: border-box;
    }

    .modal-overlay.active {
        display: flex;
        opacity: 1;
    }

    .modal-container {
        background: #ffffff;
        border-radius: 16px;
        width: 100%;
        max-width: 540px;
        max-height: calc(100vh - 40px);
        display: flex;
        flex-direction: column;
        border: 1px solid #e2e8f0;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        overflow: hidden;
        transform: translateY(20px) scale(0.95);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        margin: auto;
    }

    .modal-container.modal-lg {
        max-width: 700px;
    }

    .modal-container.modal-xl {
        max-width: 980px;
    }

    .modal-overlay.active .modal-container {
        transform: translateY(0) scale(1);
    }

    .modal-header {
        padding: 18px 24px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #f8fafc;
        flex-shrink: 0;
    }

    .modal-header h3 {
        font-size: 1.15rem;
        font-weight: 700;
        color: #0f172a;
    }

    .btn-close-modal {
        background: none;
        border: none;
        font-size: 1.25rem;
        cursor: pointer;
        color: #94a3b8;
        transition: color 0.2s ease;
    }

    .btn-close-modal:hover {
        color: #475569;
    }

    .modal-body {
        padding: 20px 24px;
        overflow-y: auto !important;
        max-height: calc(90vh - 140px);
        flex: 1 1 auto;
        min-height: 0;
    }

    /* Custom Sleek Scrollbar */
    .modal-body::-webkit-scrollbar {
        width: 8px;
    }
    .modal-body::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 6px;
    }
    .modal-body::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 6px;
    }
    .modal-body::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    .modal-footer {
        padding: 16px 24px;
        border-top: 1px solid #e2e8f0;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        background: #f8fafc;
        flex-shrink: 0;
    }

    /* Forms */
    .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: #475569;
        margin-bottom: 6px;
    }

    .form-input {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-family: inherit;
        font-size: 0.95rem;
        outline: none;
        transition: all 0.2s ease;
        color: #334155;
    }

    .form-input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .form-select {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-family: inherit;
        font-size: 0.95rem;
        outline: none;
        transition: all 0.2s ease;
        background: #ffffff;
        color: #334155;
    }

    .form-select:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .btn-cancel {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        color: #475569;
        padding: 10px 16px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

    .btn-cancel:hover {
        background: #f8fafc;
        color: #334155;
    }

    .btn-submit-action {
        background: #2563eb;
        color: #ffffff;
        border: none;
        padding: 10px 18px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

    .btn-submit-action:hover {
        background: #1d4ed8;
    }

    .modal-xl {
        max-width: 960px;
    }

    /* Sidebar-like Permission Tree Hierarchy Styles */
    .perm-sidebar-tree {
        padding: 10px 14px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .perm-tree-parent {
        border: 1px solid #f1f5f9;
        border-radius: 10px;
        background: #ffffff;
        overflow: hidden;
        transition: all 0.2s ease;
    }

    .perm-tree-parent:hover {
        border-color: #cbd5e1;
    }

    .perm-tree-parent.expanded {
        border-color: #bfdbfe;
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.05);
    }

    .perm-parent-header {
        display: flex;
        align-items: center;
        padding: 12px 16px;
        background: #fafafa;
        cursor: pointer;
        user-select: none;
        gap: 12px;
        transition: background 0.15s ease;
    }

    .perm-parent-header:hover {
        background: #f1f5f9;
    }

    .perm-tree-parent.expanded .perm-parent-header {
        background: #f8fafc;
        border-bottom: 1px solid #f1f5f9;
    }

    .perm-checkbox-custom {
        width: 18px;
        height: 18px;
        accent-color: #2563eb;
        cursor: pointer;
        flex-shrink: 0;
    }

    .perm-parent-icon {
        font-size: 1.25rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        flex-shrink: 0;
    }

    .perm-parent-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #0f172a;
        flex: 1;
        font-family: 'Outfit', sans-serif;
    }

    .perm-parent-count {
        font-size: 0.78rem;
        color: #64748b;
        font-weight: 600;
        background: #e2e8f0;
        padding: 2px 8px;
        border-radius: 9999px;
        margin-right: 6px;
    }

    .perm-parent-arrow {
        color: #64748b;
        font-size: 0.85rem;
        transition: transform 0.2s ease;
    }

    .perm-tree-parent.expanded .perm-parent-arrow {
        transform: rotate(90deg);
    }

    /* Submenu Tree container */
    .perm-submenu-tree {
        margin-left: 28px;
        padding: 10px 14px 12px 18px;
        border-left: 2px dashed #cbd5e1;
        display: flex;
        flex-direction: column;
        gap: 8px;
        background: #ffffff;
    }

    .perm-tree-parent:not(.expanded) .perm-submenu-tree {
        display: none;
    }

    .perm-submenu-item {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 8px 12px;
        border-radius: 8px;
        transition: all 0.15s ease;
    }

    .perm-submenu-item:hover {
        background: #f8fafc;
    }

    .perm-submenu-item.has-checked {
        background: #eff6ff;
    }

    .perm-submenu-header {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .perm-submenu-icon {
        font-size: 1.1rem;
        width: 24px;
        text-align: center;
        flex-shrink: 0;
    }

    .perm-submenu-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: #334155;
        flex: 1;
    }

    .perm-submenu-item.has-checked .perm-submenu-title {
        color: #2563eb;
        font-weight: 700;
    }

    .perm-code-tag {
        font-family: monospace;
        font-size: 0.7rem;
        color: #1d4ed8;
        background: #ffffff;
        border: 1px solid #bfdbfe;
        padding: 1px 6px;
        border-radius: 4px;
        font-weight: 600;
    }

    /* Sub-action permissions list */
    .perm-actions-row {
        margin-left: 34px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding-top: 2px;
    }

    .perm-action-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 0.78rem;
        color: #475569;
        cursor: pointer;
        transition: all 0.15s ease;
        user-select: none;
    }

    .perm-action-chip:hover {
        border-color: #2563eb;
        color: #2563eb;
    }

    .perm-action-chip:has(input:checked) {
        background: #dbeafe;
        border-color: #3b82f6;
        color: #1d4ed8;
        font-weight: 600;
    }

    .badge-code-mini {
        font-family: monospace;
        font-size: 0.65rem;
        color: #64748b;
        background: #f1f5f9;
        padding: 1px 4px;
        border-radius: 3px;
    }

    /* Alerts */
    .alert-box {
        border-radius: 12px;
        padding: 14px 20px;
        margin-bottom: 24px;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .alert-box-success {
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: #065f46;
    }

    .alert-box-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
    }
</style>

<style>
    .settings-nav-tabs {
        display: flex;
        gap: 8px;
        border-bottom: 1px solid #e2e8f0;
        margin-bottom: 24px;
    }

    .nav-tab-item {
        padding: 12px 20px;
        font-weight: 600;
        font-size: 0.92rem;
        color: #64748b;
        text-decoration: none;
        border-bottom: 2px solid transparent;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }

    .nav-tab-item:hover {
        color: #2563eb;
    }

    .nav-tab-item.active {
        color: #2563eb;
        border-bottom-color: #2563eb;
    }
</style>

<div class="settings-nav-tabs">
    <a href="/Settings/Users" class="nav-tab-item active">
        <span>👥</span> Người dùng & Tài khoản
    </a>
    <a href="/Settings/RoleGroups" class="nav-tab-item">
        <span>🛡️</span> Nhóm quyền mẫu (Role Groups)
    </a>
    <a href="/Settings/MenuManager" class="nav-tab-item">
        <span>📑</span> Quản lý Menu & Quyền
    </a>
    <a href="/Settings/SystemSettings" class="nav-tab-item">
        <span>⚙️</span> Cấu hình hệ thống
    </a>
</div>

<!-- Main Workspace Card -->
<div class="users-card">
    
    <!-- Success & Error Alert Messages -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert-box alert-box-success">
            <span>✅</span> @Model.SuccessMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert-box alert-box-error">
            <span>❌</span> @Model.ErrorMessage
        </div>
    }

    <div class="card-header-flex">
        <div class="card-title-group">
            <h2>Danh sách Người dùng</h2>
            <p>Quản lý tài khoản, trạng thái đăng nhập và phân quyền chi tiết các chức năng.</p>
        </div>
        <button class="btn-primary-grad" onclick="openCreateModal()">
            <span>+</span> Thêm tài khoản mới
        </button>
    </div>

    <!-- Modern Filters & Search Toolbar -->
    <form method="get" class="users-filter-bar">
        <div class="search-input-wrapper">
            <i class="fas fa-search search-icon"></i>
            <input type="text" 
                   id="userSearchInput" 
                   name="SearchTerm" 
                   value="@Model.SearchTerm" 
                   class="search-input-field" 
                   placeholder="Tìm kiếm theo Tên đăng nhập, Họ và tên, Email, SĐT..." 
                   oninput="filterUsersLive()"
                   autocomplete="off" />
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a href="/Settings/Users" class="btn-clear-search" title="Xóa tìm kiếm">✕</a>
            }
        </div>

        <div class="filter-select-wrapper">
            <select name="RoleFilter" class="filter-select" onchange="this.form.submit()">
                <option value="">-- Tất cả vai trò --</option>
                <option value="Admin" selected="@(Model.RoleFilter == "Admin")">Quản trị viên (Admin)</option>
                <option value="Staff" selected="@(Model.RoleFilter == "Staff")">Nhân viên (Staff)</option>
            </select>
        </div>

        <div class="filter-select-wrapper">
            <select name="StatusFilter" class="filter-select" onchange="this.form.submit()">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="active" selected="@(Model.StatusFilter == "active")">Đang hoạt động</option>
                <option value="locked" selected="@(Model.StatusFilter == "locked")">Đã khóa</option>
            </select>
        </div>

        <button type="submit" class="btn-filter-submit">
            <i class="fas fa-search"></i> Tìm kiếm
        </button>

        @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.RoleFilter) || !string.IsNullOrEmpty(Model.StatusFilter))
        {
            <a href="/Settings/Users" class="btn-filter-reset" title="Đặt lại bộ lọc">
                <i class="fas fa-undo"></i> Đặt lại
            </a>
        }
    </form>

    <!-- Users Table -->
    <div class="table-responsive">
        <table class="custom-table" id="usersTable">
            <thead>
                <tr>
                    <th>Họ và tên</th>
                    <th>Tên đăng nhập</th>
                    <th>Vai trò</th>
                    <th>Thông tin liên hệ</th>
                    <th>Quyền hạn</th>
                    <th>Trạng thái</th>
                    <th style="text-align: right;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.UsersList.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align: center; color: #64748b; padding: 30px;">
                            Chưa có tài khoản nào trong hệ thống.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var u in Model.UsersList)
                    {
                        var permissionIdsJson = string.Join(",", u.UserPermissions.Select(up => up.PermissionId));
                        <tr class="user-row">
                            <td style="font-weight: 600; color: #0f172a;" class="user-fullname">
                                @u.FullName
                            </td>
                            <td class="user-username">
                                <span style="font-family: monospace; font-size: 0.9rem; color: #475569;">@u.Username</span>
                            </td>
                            <td>
                                @if (u.Role == "Admin")
                                {
                                    <span class="badge badge-admin">Quản trị viên</span>
                                }
                                else
                                {
                                    <span class="badge badge-staff">Nhân viên</span>
                                }
                                @if (u.RoleGroup != null)
                                {
                                    <div style="margin-top: 4px;">
                                        <span class="badge" style="background: #eff6ff; color: #2563eb; font-size: 0.74rem; border: 1px solid #bfdbfe; font-weight: 600;">🛡️ @u.RoleGroup.Name</span>
                                    </div>
                                }
                            </td>
                            <td>
                                <div style="font-size: 0.85rem; color: #475569;">
                                    @if (!string.IsNullOrEmpty(u.Email)) { <div>📧 @u.Email</div> }
                                    @if (!string.IsNullOrEmpty(u.PhoneNumber)) { <div>📞 @u.PhoneNumber</div> }
                                    @if (!string.IsNullOrEmpty(u.TelegramId)) { <div>✈️ @u.TelegramId</div> }
                                    @if (string.IsNullOrEmpty(u.Email) && string.IsNullOrEmpty(u.PhoneNumber) && string.IsNullOrEmpty(u.TelegramId))
                                    {
                                        <span style="color: #94a3b8;">-</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (u.Role == "Admin")
                                {
                                    <span class="badge badge-perm" style="background: #e0e7ff; color: #4338ca;">Toàn quyền (Admin)</span>
                                }
                                else
                                {
                                    <span class="badge badge-perm">@u.UserPermissions.Count quyền</span>
                                }
                            </td>
                            <td>
                                @if (u.IsLocked)
                                {
                                    <span class="badge badge-locked">Đã khóa</span>
                                }
                                else
                                {
                                    <span class="badge badge-active">Hoạt động</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div class="action-btn-group" style="justify-content: flex-end;">
                                    <!-- Phân quyền -->
                                    <button class="btn-action-outline edit" title="Phân quyền tài khoản"
                                            onclick="openPermissionModal(@u.Id, '@u.Username', [@permissionIdsJson], @(u.RoleGroupId ?? 0))">
                                        🔑
                                    </button>

                                    <!-- Chỉnh sửa thông tin -->
                                    <button class="btn-action-outline edit" title="Chỉnh sửa thông tin"
                                            onclick="openEditModal(@u.Id, '@u.Username', '@Html.Raw(Html.Encode(u.FullName))', '@u.Role', '@u.Email', '@u.PhoneNumber', '@u.TelegramId', @(u.RoleGroupId ?? 0))">
                                        ✏️
                                    </button>

                                    <!-- Khóa / Mở khóa -->
                                    <form method="post" asp-page-handler="ToggleLock" asp-route-userId="@u.Id" onsubmit="return confirmLock('@u.Username', @((!u.IsLocked).ToString().ToLower()));" style="display:inline;">
                                        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                        <input type="hidden" name="RoleFilter" value="@Model.RoleFilter" />
                                        <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                        <input type="hidden" name="PageIndex" value="@Model.PageIndex" />
                                        @if (u.IsLocked)
                                        {
                                            <button type="submit" class="btn-action-outline unlock" title="Mở khóa tài khoản">
                                                🔓
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn-action-outline lock" title="Khóa tài khoản">
                                                🔒
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        var filterQuery = $"&SearchTerm={Uri.EscapeDataString(Model.SearchTerm ?? "")}&RoleFilter={Uri.EscapeDataString(Model.RoleFilter ?? "")}&StatusFilter={Uri.EscapeDataString(Model.StatusFilter ?? "")}";
        <div class="pagination-container">
            <span class="pagination-info">
                Trang @Model.PageIndex / @Model.TotalPages (Tổng số @Model.TotalItems tài khoản)
            </span>
            <div class="pagination-actions">
                @if (Model.PageIndex > 1)
                {
                    <a href="/Settings/Users?pageIndex=@(Model.PageIndex - 1)@filterQuery" class="btn-page">Trang trước</a>
                }
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    if (p == Model.PageIndex)
                    {
                        <span class="btn-page active">@p</span>
                    }
                    else
                    {
                        <a href="/Settings/Users?pageIndex=@p@filterQuery" class="btn-page">@p</a>
                    }
                }
                @if (Model.PageIndex < Model.TotalPages)
                {
                    <a href="/Settings/Users?pageIndex=@(Model.PageIndex + 1)@filterQuery" class="btn-page">Trang sau</a>
                }
            </div>
        </div>
    }
</div>

<!-- 1. Modal Thêm người dùng -->
<div class="modal-overlay" id="createModalOverlay">
    <div class="modal-container modal-lg">
        <form method="post" asp-page-handler="CreateUser">
            <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
            <input type="hidden" name="RoleFilter" value="@Model.RoleFilter" />
            <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
            <input type="hidden" name="PageIndex" value="@Model.PageIndex" />
            <div class="modal-header">
                <h3>Thêm người dùng mới</h3>
                <button type="button" class="btn-close-modal" onclick="closeModal('createModalOverlay')">×</button>
            </div>
            <div class="modal-body">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label class="form-label" for="createFullName">Họ và tên</label>
                        <input type="text" id="createFullName" name="fullName" class="form-input" placeholder="Ví dụ: Nguyễn Văn A" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="createUsername">Tên đăng nhập</label>
                        <input type="text" id="createUsername" name="username" class="form-input" placeholder="Ví dụ: nguyenvana" required />
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label class="form-label" for="createPassword">Mật khẩu</label>
                        <input type="password" id="createPassword" name="password" class="form-input" placeholder="Nhập mật khẩu ban đầu" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="createRole">Vai trò hệ thống</label>
                        <select id="createRole" name="role" class="form-select">
                            <option value="Staff">Nhân viên (Staff)</option>
                            <option value="Admin">Quản trị viên (Admin)</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label" for="createRoleGroup">
                        <span>🛡️ Áp dụng nhóm quyền mẫu (Tùy chọn)</span>
                    </label>
                    <select id="createRoleGroup" name="roleGroupId" class="form-select">
                        <option value="">-- Mặc định theo vai trò (Admin / Staff) --</option>
                        @foreach (var rg in Model.AllRoleGroups)
                        {
                            <option value="@rg.Id">🛡️ @rg.Name (@rg.RoleGroupPermissions.Count quyền)</option>
                        }
                    </select>
                    <small style="color: #64748b; font-size: 0.78rem; margin-top: 4px; display: block;">
                        Chọn nhóm quyền mẫu để hệ thống tự động gán toàn bộ quyền của vị trí này cho tài khoản mới.
                    </small>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label class="form-label" for="createEmail">Email</label>
                        <input type="email" id="createEmail" name="email" class="form-input" placeholder="Viết dạng: a@rental.com" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="createPhoneNumber">Số điện thoại</label>
                        <input type="text" id="createPhoneNumber" name="phoneNumber" class="form-input" placeholder="Ví dụ: 0987654321" />
                    </div>
                </div>
                <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label" for="createTelegramId">Telegram ID</label>
                    <input type="text" id="createTelegramId" name="telegramId" class="form-input" placeholder="Ví dụ: 123456789 (Nhận thông báo đơn hàng)" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" onclick="closeModal('createModalOverlay')">Hủy bỏ</button>
                <button type="submit" class="btn-submit-action">Tạo tài khoản</button>
            </div>
        </form>
    </div>
</div>

<!-- 2. Modal Sửa thông tin người dùng -->
<div class="modal-overlay" id="editModalOverlay">
    <div class="modal-container modal-lg">
        <form method="post" asp-page-handler="UpdateUser">
            <input type="hidden" id="editUserId" name="userId" />
            <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
            <input type="hidden" name="RoleFilter" value="@Model.RoleFilter" />
            <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
            <input type="hidden" name="PageIndex" value="@Model.PageIndex" />
            <div class="modal-header">
                <h3>Chỉnh sửa thông tin tài khoản</h3>
                <button type="button" class="btn-close-modal" onclick="closeModal('editModalOverlay')">×</button>
            </div>
            <div class="modal-body">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label class="form-label" for="editFullName">Họ và tên</label>
                        <input type="text" id="editFullName" name="fullName" class="form-input" required />
